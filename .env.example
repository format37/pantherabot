# Copy this file to `.env` and fill in the values on the server
# Never commit your real secrets

LANGCHAIN_API_KEY=
OPENAI_API_KEY=
WOLFRAM_ALPHA_APPID=
BFL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SERPER_API_KEY=
PERPLEXITY_API_KEY=
TELEGRAM_BOT_TOKEN=

# Home of the user whose ~/.claude holds the Claude CLI auth (bind-mounted into
# the container). Required by docker-compose.yml; compose.sh derives it
# automatically if unset here. Example: /home/ubuntu
CLAUDE_HOME=

# Telegram local bot-api file-storage dir name (bot token without the numeric prefix)
BOT_TOKEN_WITHOUT_PREFIX=

# Optional
BOT_USERNAME=
PERPLEXITY_MCP_URL=
LANGCHAIN_PROJECT=panthera
TZ=America/Los_Angeles
