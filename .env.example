# Copy this file to `.env` and fill in the values on the server
# Never commit your real secrets

LANGCHAIN_API_KEY=
OPENAI_API_KEY=
WOLFRAM_ALPHA_APPID=
BFL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SERPER_API_KEY=
PERPLEXITY_API_KEY=
TELEGRAM_BOT_TOKEN=

# Home of the user that owns ~/.claude-bot — the bot's own Claude CLI config dir
# (created with `CLAUDE_CONFIG_DIR=~/.claude-bot claude auth login`, see README).
# It is bind-mounted into the container. Required by docker-compose.yml;
# compose.sh derives it automatically if unset here. Example: /home/ubuntu
CLAUDE_HOME=

# Telegram local bot-api file-storage dir name (bot token without the numeric prefix)
BOT_TOKEN_WITHOUT_PREFIX=

# Shared secret between the head and the sandbox exec service (any random
# string, e.g. `openssl rand -hex 16`). The socket is already only reachable by
# containers mounting ./run; this is one more lock on it.
SANDBOX_TOKEN=

# Optional
BOT_USERNAME=
PERPLEXITY_MCP_URL=
LANGCHAIN_PROJECT=panthera
TZ=America/Los_Angeles
